JIRA_BASE_URL=https://vudusoft.atlassian.net
JIRA_EMAIL=deine@email.de
JIRA_API_TOKEN=hier-dein-api-token
JIRA_PROJECT_KEY=EMP
API_PORT=8787

# Implementierer-Anbindung: lokaler Klon des Emperor-Repos und die Claude-CLI
EMPEROR_DIR=C:\Projects\Emperor
CLAUDE_BIN=claude
# Werkzeuge, die der Lauf ohne Rückfrage nutzen darf (Rückfragen kann niemand beantworten)
IMPLEMENTER_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash,PowerShell,Agent,Artifact,mcp__atlassian

# Nutzungslimits: der Server liest den OAuth-Token aus ~/.claude/.credentials.json.
# Nur setzen, wenn der Anmeldespeicher woanders liegt. Kein Token gehört in diese Datei —
# ein Token aus `claude setup-token` wird vom Endpunkt ohnehin mit 403 abgewiesen.
# CLAUDE_CONFIG_DIR=
