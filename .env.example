API_PORT=8787

# Ablage der Tickets. Standard: data/board.db im Projektordner.
# BOARD_DB=

# Nutzungslimits: der Server liest den OAuth-Token aus ~/.claude/.credentials.json.
# Nur setzen, wenn der Anmeldespeicher woanders liegt. Kein Token gehört in diese Datei —
# ein Token aus `claude setup-token` wird vom Endpunkt ohnehin mit 403 abgewiesen.
# CLAUDE_CONFIG_DIR=
